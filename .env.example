# ==============================================================================
# PAIMANA Infrastructure Intelligence Platform - Environment Configuration
# ==============================================================================

# Application Environment (development, testing, production)
ENVIRONMENT=development
DEBUG=True
SECRET_KEY=change-this-in-production-to-a-secure-random-64-character-string
API_V1_STR=/api/v1
PROJECT_NAME="PAIMANA Infrastructure Intelligence"

# Database Configuration
# Local development default: SQLite
DATABASE_URL=sqlite:///./paimana.db
# PostgreSQL for production/Docker:
# DATABASE_URL=postgresql://paimana_user:paimana_password@localhost:5432/paimana_db

# Frontend URL for CORS
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]

# Machine Learning Artifacts Path
ML_MODEL_DIR=./ml/artifacts
ENABLE_FALLBACK_SCORING=True

# AI Assistant Configuration
# Options: mock, gemini, openai
LLM_PROVIDER=mock
GEMINI_API_KEY=
OPENAI_API_KEY=
LLM_MODEL_NAME=gemini-1.5-flash

# Logging
LOG_LEVEL=INFO
